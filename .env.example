# Copy to .env and fill in. Never commit .env.
# App settings use ASP.NET Core names: Section__Key (double underscore).

# Image version: latest, or sha-<commit> to pin / roll back.
IMAGE_TAG=latest

# --- Database ---
POSTGRES_PASSWORD=change-me-long-random-password

# --- Reverse proxy ---
# Only for the optional Caddy service (--profile caddy): the domain pointing at this server.
DOMAIN=rekrutacja.example.com
# Host port of the app (bound to 127.0.0.1) when you use your own reverse proxy.
APP_PORT=8080

# --- First admin (created on first start only, when no admin exists) ---
# Password: min. 6 chars with upper- and lowercase letter, digit and symbol. Change it after first login.
SeedAdmin__Email=admin@example.com
SeedAdmin__Password=
SeedAdmin__DisplayName=Admin

# --- Club ---
# Public address of the app – used for booking links in e-mails.
Club__PublicUrl=https://rekrutacja.example.com
Club__ContactEmail=rekrutacja@example.com
Club__InterviewLocation=Room 101, Faculty building
Club__TimeZone=Europe/Warsaw

# --- E-mail (SMTP) – see docs/EMAIL.md. Empty host = e-mail disabled. ---
Email__Host=
Email__Port=587
Email__Security=StartTls
Email__Username=
Email__Password=
Email__FromAddress=
Email__FromName=Rekrutacja
Email__ReplyTo=
Email__DelayBetweenMessagesMs=3000
